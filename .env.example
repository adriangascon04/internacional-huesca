# Plantilla de configuración de Firebase.
# NOTA: este proyecto NO usa build, así que estos valores se escriben a mano en
# public/src/config/firebase.js. Este archivo es solo documentación/referencia.
# La apiKey de una app web NO es un secreto: la seguridad vive en firestore.rules.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=internacional-huesca-nacho.firebaseapp.com
FIREBASE_PROJECT_ID=internacional-huesca-nacho
FIREBASE_STORAGE_BUCKET=internacional-huesca-nacho.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

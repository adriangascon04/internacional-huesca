{
  "name": "internacional-huesca",
  "version": "1.0.0",
  "description": "Gestión de abonados del Internacional Huesca (PWA, módulos ES nativos, sin build)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx --yes serve -l 8080 .",
    "lint": "eslint \"src/**/*.js\"",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\"",
    "test": "node --import ./tests/setup.js --test tests/*.test.js"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5"
  }
}

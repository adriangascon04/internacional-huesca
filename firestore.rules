rules_version = '2';
// ============================================================================
//  REGLAS DE SEGURIDAD · Internacional Huesca
//
//  ⚠️  ESTE FICHERO NO SE DESPLIEGA SOLO. GitHub Pages solo sirve HTML/JS.
//  Para que un cambio aquí tenga efecto hay que pegarlo en
//  Firebase Console → Firestore → Reglas → Publicar.
//  Mantén este fichero SIEMPRE igual a lo publicado: si divergen, republicar
//  desde aquí revierte en silencio lo que hubiera en la consola.
//
//  RECORDATORIO sobre cómo evalúa Firestore: las reglas son PERMISIVAS y se
//  combinan con OR. Si una regla concede acceso, otra posterior NO lo quita.
//  Y `allow write` = create + update + delete.
//  Por eso el patrón:
//        allow write:  if puedeEscanear();
//        allow delete: if esAdmin();
//  era ENGAÑOSO: el `write` ya concedía delete a control_acceso y la segunda
//  línea no restringía nada. Aquí se usan siempre verbos separados.
//
//  Roles: admin | taquillero | control_acceso | lector
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() { return request.auth != null; }

    function datosUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // ÚNICA normalización de rol del servidor, gemela de core/roles.js.
    //
    // Antes cada función repetía a mano la lista
    // ['admin','Admin','ADMIN','main','Main','MAIN', ...]: una grafía que no
    // estuviera en la lista ("MAIn") o un espacio de más al teclear el rol en la
    // consola de Firebase colaba por el cliente (que hace trim + lower) y NO por
    // el servidor. De ahí venían los "necesitas ser Main" teniendo la sesión de
    // Main abierta: la UI te dejaba pulsar y la escritura la rechazaba el
    // servidor. El lenguaje de reglas no tiene trim(), así que los espacios se
    // absorben con la propia expresión regular.
    //
    // Los roles de /usuarios los pone una persona a mano en la consola: esto
    // tiene que ser tolerante con cómo los escriba.
    function rolCrudo() {
      return datosUsuario().rol is string ? datosUsuario().rol.lower() : '';
    }
    function esRol(nombre) { return rolCrudo().matches('\\s*' + nombre + '\\s*'); }

    // "main" es sinónimo histórico de "admin".
    // puedeVender/puedeEscanear DERIVAN de esAdmin en vez de volver a nombrarlo:
    // así es imposible añadir un permiso nuevo y olvidarse de dárselo a Main.
    function esAdmin()       { return autenticado() && (esRol('admin') || esRol('main')); }
    function puedeVender()   { return esAdmin() || (autenticado() && esRol('taquillero')); }
    function puedeEscanear() { return esAdmin() || (autenticado() && esRol('control_acceso')); }

    // ¿Está cerrada el acta de esta jornada? Antes solo se comprobaba en el
    // cliente: bastaba la consola del navegador para escribir en una jornada
    // cerrada. Ahora lo impone el servidor.
    function jornadaAbierta(jornadaId) {
      return !exists(/databases/$(database)/documents/jornadas_bloqueadas/$(jornadaId))
        || get(/databases/$(database)/documents/jornadas_bloqueadas/$(jornadaId)).data.bloqueada != true;
    }

    // Nº de ventas registradas en un doc de taquilla. Los documentos anteriores
    // a que existiera el historial NO tienen el campo, y `historial.size()` a
    // secas reventaba la regla (y con ella la venta) en esas jornadas.
    function nVentas(datos) {
      return datos.historial is list ? datos.historial.size() : 0;
    }

    // Campos que solo el servidor/admin debería fijar.
    function noTocaAuditoria() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['creadoPor', 'creadoEn', 'numerico', 'alta']);
    }

    function tocado(campo) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([campo]);
    }

    // La firma de auditoría la escribe el CLIENTE, así que sin esto cualquiera
    // podía firmar sus cambios con el correo de otro. `request.auth.token.email`
    // sale del token y no es falsificable. Se comprueba solo si el campo se
    // toca: `bajaSocio` firma con bajaPor y NO escribe modificadoPor, y exigirlo
    // siempre rompería las bajas.
    function firmaValida() {
      return (!tocado('modificadoPor')
              || request.resource.data.modificadoPor == request.auth.token.email)
          && (!tocado('bajaPor')
              || request.resource.data.bajaPor == request.auth.token.email);
    }

    // ---------------------------------------------------------------- usuarios
    // Cada uno lee el suyo; solo admin escribe. Un usuario NO puede ascenderse.
    match /usuarios/{uid} {
      allow get: if autenticado() && (request.auth.uid == uid || esAdmin());
      allow list: if esAdmin();
      allow create, update, delete: if esAdmin();
    }

    // ------------------------------------------------------------------ socios
    // Lectura: cualquier autenticado (el escáner la necesita).
    // LIMITACIÓN ASUMIDA: esto expone DNI/teléfono/email a todos los roles.
    // Las reglas conceden documentos enteros, no campos. Ocultar el DNI a un
    // taquillero exigiría Cloud Functions (plan de pago).
    // `numerico` = identidad interna: la fija el contador, es inmutable
    // (noTocaAuditoria la protege) y es la clave del historial de entradas.
    // `carnet` = nº impreso y visible: SÍ es mutable, porque se compacta al
    // renumerar cada temporada. Reutilizar ese número es inofensivo solo
    // porque el QR lleva además el token del socio.
    //
    // BORRADO: antes era `allow delete: if false` y la única forma de quitar a
    // alguien era la baja lógica (activo:false). El club no quiere ese rastro
    // —un socio que se quita es casi siempre un alta equivocada— y además hacía
    // imposible el "borrón y cuenta nueva" al terminar las pruebas. Ahora admin
    // puede borrar de verdad. El nº de carnet que queda libre se reutiliza, pero
    // eso NO resucita el carnet borrado: el QR lleva el token del socio, que es
    // distinto para cada uno. Y el id interno no se reutiliza nunca, porque lo
    // reparte el contador de más abajo, que solo sabe subir.
    match /socios/{id} {
      allow read: if autenticado();
      allow create: if esAdmin()
        && request.resource.data.activo == true
        && request.resource.data.numerico is number
        && request.resource.data.carnet is number
        && request.resource.data.creadoPor == request.auth.token.email;
      allow update: if esAdmin() && noTocaAuditoria() && firmaValida();
      allow delete: if esAdmin();
    }

    // ---------------------------------------------------------------- entradas
    // Un doc por jornada: { <socioId>: <ISO> }.
    match /entradas/{jornada} {
      allow read: if autenticado();

      allow create: if puedeEscanear() && jornadaAbierta(jornada);

      // Un control_acceso solo puede AÑADIR accesos, nunca eliminarlos: se
      // exige que todas las claves previas sigan presentes. Corregir un error
      // (borrar un acceso) queda reservado a admin.
      allow update: if jornadaAbierta(jornada) && (
        esAdmin()
        || (puedeEscanear()
            && request.resource.data.keys().hasAll(resource.data.keys()))
      );

      allow delete: if esAdmin();
    }

    // ---------------------------------------------------------------- taquilla
    // Un doc por jornada: { <tipo>: <contador>, historial:[{tipo,precio,...}] }.
    // Los tipos de entrada son CONFIGURABLES por partido, así que aquí no se
    // puede dar por hecho que solo existan `general` y `menor`.
    match /taquilla/{jornada} {
      allow read: if autenticado();

      // El doc solo puede nacer sin ventas. Así la primera venta de la jornada
      // no puede crearlo ya con el historial falseado, saltándose el límite de
      // una venta por escritura del `update`.
      allow create: if puedeVender() && jornadaAbierta(jornada)
        && request.resource.data.historial is list
        && request.resource.data.historial.size() == 0;

      // Un taquillero solo puede mover UNA venta por escritura: la que acaba de
      // cobrar, o la que deshace. Antes el tope se expresaba sobre los
      // contadores `general`/`menor` (±1), de forma que al pasar los tipos a ser
      // configurables cualquier tipo nuevo (`vip`, `invitacion`…) se quedaba sin
      // tope y se podía escribir de una vez la cifra que se quisiera. Acotar el
      // TAMAÑO del historial vale para cualquier tipo, presente o futuro.
      allow update: if jornadaAbierta(jornada) && (
        esAdmin()
        || (puedeVender()
            && request.resource.data.historial is list
            && (request.resource.data.historial.size() == nVentas(resource.data) + 1
                || request.resource.data.historial.size() == nVentas(resource.data) - 1))
      );

      allow delete: if esAdmin();
    }

    // Calendario editable: cada competición contiene sus partidos ordenados y
    // las tarifas específicas de cada uno. Solo administración lo modifica.
    match /competiciones/{id} {
      allow read: if autenticado();
      allow create, update, delete: if esAdmin();
    }

    // ---------------------------------------------------- jornadas_bloqueadas
    // Cerrar/abrir el acta: solo admin, y firmado con su propio correo.
    match /jornadas_bloqueadas/{jornada} {
      allow read: if autenticado();
      allow create, update: if esAdmin()
        && request.resource.data.bloqueadaPor == request.auth.token.email;
      allow delete: if esAdmin();
    }

    // ----------------------------------------------------------------- backups
    // Contienen datos personales de todos los socios -> solo admin.
    match /backups/{id} {
      allow read, delete: if esAdmin();
      allow create: if esAdmin()
        && request.resource.data.creadoPor == request.auth.token.email;
      allow update: if false;  // una copia no se edita
    }

    // ------------------------------------------------------------------ config
    // Documento único config/jornada_actual: cuál es "la jornada de hoy".
    // Un control_acceso solo lee (para que el escáner sepa a qué restringirse);
    // solo admin la fija, firmada con su propio correo.
    match /config/{id} {
      allow read: if autenticado();
      allow create, update: if esAdmin()
        && request.resource.data.actualizadoPor == request.auth.token.email;
      allow delete: if esAdmin();
    }

    // -------------------------------------------------------------- contadores
    // El contador de números de socio SOLO puede subir. Si pudiera bajar,
    // volveríamos a reutilizar números y a los "QR zombie" del bug original.
    match /contadores/{id} {
      allow read: if autenticado();
      allow create: if esAdmin() && request.resource.data.ultimo is number;
      allow update: if esAdmin()
        && request.resource.data.ultimo is number
        && request.resource.data.ultimo > resource.data.ultimo;
      allow delete: if false;
    }

    // Todo lo demás: denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
